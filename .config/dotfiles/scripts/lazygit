#!/usr/bin/env bash
# Author: Alalilacias
# Description: Installs Lazygit via package manager or GitHub release (fallback for apt), verifying the release checksum
# Syntax: source "$HOME/.dotfiles/.config/dotfiles/scripts/lazygit"
# Version: 0.4

install_lazygit_from_github() {
  local arch release_arch version base_url tarball tmp_dir

  arch=$(uname -m)
  case "$arch" in
  x86_64) release_arch="x86_64" ;;
  aarch64 | arm64) release_arch="arm64" ;;
  *)
    log_error "Manual install does not support architecture: $arch"
    return 1
    ;;
  esac

  version=$(curl -fsSL "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": *"v\K[^"]*')
  if [[ -z "$version" ]]; then
    log_error "Could not determine the latest lazygit version."
    return 1
  fi

  base_url="https://github.com/jesseduffield/lazygit/releases/download/v${version}"
  tarball="lazygit_${version}_Linux_${release_arch}.tar.gz"
  tmp_dir=$(mktemp -d -t lazygit-install-XXXXXX)

  log_debug "Downloading lazygit $version from GitHub..."
  curl -fsSL -o "$tmp_dir/$tarball" "$base_url/$tarball"
  curl -fsSL -o "$tmp_dir/checksums.txt" "$base_url/checksums.txt"

  if ! (cd "$tmp_dir" && grep " $tarball\$" checksums.txt | sha256sum -c --status -); then
    log_error "Checksum verification failed for $tarball."
    rm -rf "$tmp_dir"
    return 1
  fi

  tar -C "$tmp_dir" -xf "$tmp_dir/$tarball" lazygit
  sudo install "$tmp_dir/lazygit" -D -t /usr/local/bin/
  rm -rf "$tmp_dir"

  log_info "lazygit installed manually from GitHub."
}

log_debug "Checking for lazygit..."

if command -v pacman &>/dev/null; then
  log_debug "Detected pacman. Installing lazygit..."
  sudo pacman -Sy --noconfirm lazygit
elif command -v dnf &>/dev/null; then
  log_debug "Detected dnf. Installing lazygit..."
  sudo dnf install -y lazygit
elif command -v apt &>/dev/null; then
  log_debug "Detected apt. Checking if lazygit is available..."
  if apt-cache show lazygit &>/dev/null; then
    log_debug "Installing lazygit from apt..."
    sudo apt update
    sudo apt install -y lazygit
  else
    log_debug "lazygit not available in apt. Falling back to GitHub binary release..."
    install_lazygit_from_github || return 1
  fi
else
  log_error "Unsupported package manager. Please install lazygit manually."
  return 1
fi

log_info "lazygit installation complete."
