#!/usr/bin/env bash
# Author: Alalilacias
# Description: Installs fd (modern find) via cargo
# Syntax: source "$HOME/.dotfiles/.config/dotfiles/scripts/fd-find"
# Version: 0.4

if ! command -v cargo &>/dev/null; then
  log_error "Rust/cargo is required but not found in PATH."
  return 1
fi

if command -v fd &>/dev/null; then
  log_notice "fd is already installed"
  return 0
fi

log_info "Installing fd-find using cargo..."
cargo install --locked fd-find

log_info "fd installed successfully."
