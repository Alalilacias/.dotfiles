#!/usr/bin/env bash
# Author: Alalilacias
# Description: Installs Mermaid CLI (mmdc) via npm
# Syntax: source "$HOME/.dotfiles/.config/dotfiles/scripts/mmdc"
# Version: 0.6

log_debug "Checking for npm..."
if ! command -v npm &>/dev/null; then
  log_error "npm not found. Please install Node.js first."
  return 1
fi

npm install -g @mermaid-js/mermaid-cli

log_info "mmdc installed successfully."
